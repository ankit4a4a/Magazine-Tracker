<%# Fixed full-screen looping background video + black overlay. Put your video at public/video/bg.mp4 %>
<div class="mt-bg" aria-hidden="true">
  <video class="mt-bg-video" autoplay muted loop playsinline preload="auto" disablepictureinpicture>
    <source src="/video/bg.mp4" type="video/mp4" />
  </video>
  <div class="mt-bg-overlay"></div>
</div>
