<!DOCTYPE html>
<html lang="en">
<head>
  <title>User Saved - Magazine Tracker</title>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/bgVideo') %>
  <div class="flex min-h-screen w-full">
    <% var active = 'users' %>
    <%- include('../partials/adminSidebar') %>

    
    <main class="flex-1 min-w-0 p-8 flex items-start justify-center">
      <div class="bg-white rounded-xl shadow p-6 max-w-md w-full mt-6">
        <div class="flex items-center gap-2 mb-1">
          <span class="text-green-600 text-xl">✅</span>
          <h1 class="text-xl font-bold text-gray-800">User Saved</h1>
        </div>
        <p class="text-sm text-gray-500 mb-5">Share these login details with <%= name %>.</p>

        <div class="space-y-3 mb-5">
          <div class="bg-gray-50 border border-gray-200 rounded-lg px-4 py-3">
            <p class="text-xs text-gray-500">Name</p>
            <p class="font-semibold text-gray-800"><%= name %></p>
          </div>
          <div class="bg-gray-50 border border-gray-200 rounded-lg px-4 py-3">
            <p class="text-xs text-gray-500">Phone Number</p>
            <p class="font-semibold text-gray-800"><%= phone %></p>
          </div>
          <div class="bg-gray-50 border border-gray-200 rounded-lg px-4 py-3">
            <p class="text-xs text-gray-500">Password</p>
            <p class="font-semibold text-gray-800 font-mono"><%= password %></p>
          </div>
        </div>

        <a href="<%= waLink %>" target="_blank" rel="noopener"
          class="flex items-center justify-center gap-2 w-full bg-green-600 hover:bg-green-700 text-white font-semibold py-2.5 rounded-lg mb-3">
          💬 Share via WhatsApp
        </a>

        <a href="/admin/users"
          class="block text-center w-full border border-gray-300 text-gray-700 hover:bg-gray-50 font-semibold py-2.5 rounded-lg">
          Continue to Users
        </a>

        <p class="text-xs text-gray-400 mt-4 text-center">
          This password is shown only once here — it isn't stored anywhere as plain text, so save/share it now.
        </p>
      </div>
    </main>
  </div>
</body>
</html>
